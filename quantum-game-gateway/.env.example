# Root-readable production file: /etc/quantum-echoes-gateway.env (mode 0600).
# Keep all values out of Git, game source, native packages, and Web exports.
QUANTUM_GAME_API_KEY=
QUANTUM_GAME_UPSTREAM_BASE=http://127.0.0.1:8000/v1
QUANTUM_GAME_ALLOWED_ORIGINS=https://davidjgrimsley.com,https://www.davidjgrimsley.com
QUANTUM_GAME_UPSTREAM_TIMEOUT_SECONDS=10
REDIS_URL=redis://127.0.0.1:6379/1
